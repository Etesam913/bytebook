{
  "name": "bytebook",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "check": "bun scripts/check.ts",
    "check:fix": "bun scripts/check.ts --fix",
    "check:fe": "bun scripts/check.ts --fe",
    "check:be": "bun scripts/check.ts --be && test -z \"$(gofmt -l internal *.go)\"",
    "check:ci": "bun scripts/check.ts --ci",
    "test:scripts": "bun test ./scripts/check.test.ts ./scripts/bundle-config.test.ts",
    "format": "bun --cwd frontend run format",
    "lint": "bun --cwd frontend run lint",
    "test:unit": "cd frontend && bun run test:unit"
  }
}
