{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:clear-port && cd .. && wails3 dev -config ./build/config.yml --port 5173",
    "dev:clear-port": "lsof -tiTCP:5173 -sTCP:LISTEN | while read -r pid; do kill \"$pid\"; done",
    "dev:internal": "vite",
    "e2e:prepare": "cd .. && wails3 generate bindings ./internal/... && go run ./scripts/generate-events",
    "build": "vite build --mode production",
    "build:analyze": "VITE_ANALYZE=true vite build --mode production",
    "test:unit": "bun test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ci": "bun run e2e:prepare && playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui -c tests/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "lint:check": "bun run eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "tsgo": "tsgo",
    "check": "cd .. && bun scripts/check.ts",
    "size": "size-limit",
    "knip": "bunx knip --production",
    "knip:ci": "bunx knip --reporter github-actions --reporter compact --production"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@floating-ui/react": "^0.27.20",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@react-aria/overlays": "^3.32.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-query": "^5.105.1",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "jotai": "^2.20.3",
    "lexical": "^0.53.0",
    "motion": "^12.43.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-use-measure": "^2.1.7",
    "react-virtuoso": "^4.18.20",
    "sonner": "^2.0.8",
    "wouter": "^3.13.0"
  },
  "overrides": {
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@wailsio/runtime": "3.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "prettier": "3.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "size-limit": "^12.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "^8.3.5"
  },
  "patchedDependencies": {
    "@pierre/trees@1.0.0-beta.6": "patches/@pierre%2Ftrees@1.0.0-beta.6.patch"
  }
}
