@@ -164,6 +164,16 @@ var FileTree = class {
 	getItemHeight() {
 		return this.#density.itemHeight;
 	}
+	setItemHeight(itemHeight) {
+		if (!Number.isFinite(itemHeight) || itemHeight <= 0 || itemHeight === this.#density.itemHeight) return;
+		this.#density = { ...this.#density, itemHeight };
+		this.#viewOptions.itemHeight = itemHeight;
+		const mountedTree = this.#getMountedTreeElements();
+		if (mountedTree == null) return;
+		mountedTree.host.style.setProperty("--trees-item-height", `${itemHeight}px`);
+		this.#wroteHostItemHeight = true;
+		renderFileTreeRoot(mountedTree.wrapper, this.#getViewProps());
+	}
 	getDensityFactor() {
 		return this.#density.factor;
 	}
